APP_NAME=VMS Web
CLIENT_ID=vms-web-dev
PORT=4003
APP_ORIGIN=http://localhost:4003
IDENTITY_BASE_URL=http://localhost:3001
IDENTITY_ISSUER=http://localhost:3001
AUTHZ_BASE_URL=http://localhost:3002
# Service principal registered in the Authorization service (AUTHZ_CHECK, own clients only).
# This backend signs short-lived RS256 service tokens; public keys at /.well-known/jwks.json. No API keys.
SERVICE_PRINCIPAL_ID=vms-backend
AUTHZ_AUDIENCE=miqaat-core-authorization
# The BU's own Redis (demo reuses a separate DB index on the local Redis)
REDIS_URL=redis://localhost:6391/2
SESSION_COOKIE_NAME=vms_session
DEMO_MODULE=VMS_EVENTS
DEMO_ACTIONS=view,create,edit
OTHER_APPS=RMS Web|http://localhost:4001,AMS Web|http://localhost:4002

# Encrypted application session cookie (JWE dir + A256GCM): lifetime of the app session and its key.
SESSION_TTL_SECONDS=28800
# SESSION_ENC_KEY=<32 random bytes, base64url>  required in production; development generates .keys/<client_id>-session.key
