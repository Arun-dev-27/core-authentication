  "item": [
    {
      "name": "1. Sign in (portal, CSRF, tokens)",
      "description": "Run top to bottom. Variables are filled by the test scripts.",
      "item": [
        {
          "name": "Portal page (saves transaction_id + csrf)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP ' + pm.response.code, () => pm.expect(pm.response.code).to.be.below(400));",
                  "if (pm.response.code >= 400) console.log(pm.response.text());",
                  "const m = pm.response.text().match(/id=\"miqaat-boot\"[^>]*>([\\s\\S]*?)<\\/script>/);",
                  "pm.test('login page boot JSON found', () => pm.expect(m, 'no boot JSON: read the HTML error page in the response').to.not.equal(null));",
                  "if (m) {",
                  "  const boot = JSON.parse(m[1]);",
                  "  pm.collectionVariables.set('transaction_id', boot.transaction_id);",
                  "  pm.collectionVariables.set('csrf', boot.csrf);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{identity}}/portal"
          }
        },
        {
          "name": "POST /login (workspaces)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP ' + pm.response.code, () => pm.expect(pm.response.code).to.be.below(400));",
                  "if (pm.response.code >= 400) console.log(pm.response.text());",
                  "const b = pm.response.code < 400 ? pm.response.json() : {};",
                  "const list = b.assignments || [];",
                  "const pick = list.find((a) => a.scope_type === 'CORE') || list[0];",
                  "if (pick) {",
                  "  pm.collectionVariables.set('role_id', pick.role_id);",
                  "  pm.collectionVariables.set('scope_type', pick.scope_type);",
                  "  pm.collectionVariables.set('scope_id_json', pick.scope_id ? JSON.stringify(pick.scope_id) : 'null');",
                  "}",
                  "if (b.active_scope && b.token) { pm.collectionVariables.set('access_token', b.token); pm.globals.set('access_token', b.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{identity}}"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf}}"
              }
            ],
            "url": "{{identity}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_id\": \"{{transaction_id}}\",\n  \"identity_type\": \"ITS\",\n  \"its_id\": \"{{its_id}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Same as POST /portal/login. Returns every workspace; with exactly one it is activated and a scoped token is returned. Non-ITS: \"identity_type\": \"NON_ITS\", \"identifier\": \"<email>\"."
          }
        },
        {
          "name": "POST /select-scope (audience authorization → access_token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP ' + pm.response.code, () => pm.expect(pm.response.code).to.be.below(400));",
                  "if (pm.response.code >= 400) console.log(pm.response.text());",
                  "const b = pm.response.code < 400 ? pm.response.json() : {};",
                  "if (b.token) { pm.collectionVariables.set('access_token', b.token); }",
                  "if (b.token) { pm.globals.set('access_token', b.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
