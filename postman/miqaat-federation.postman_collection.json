            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_id\": \"{{transaction_id}}\",\n  \"role_id\": \"{{role_id}}\",\n  \"scope_type\": \"{{scope_type}}\",\n  \"scope_id\": {{scope_id_json}},\n  \"audience\": \"authorization\"\n}",
