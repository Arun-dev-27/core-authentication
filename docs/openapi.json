        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "POST /select-scope - { role_id, scope_type, scope_id } -> { active_scope, token }",
        "tags": [
          "core-login"
        ]
      }
    }
  },
  "info": {
    "title": "Miqaat Identity Federation Service",
    "description": "Central embedded login, federation sessions, RS256 assertions (JWKS), SSO and federation logout. Authentication only - authorization decisions live in the Core Identity Authorization Service.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateTransactionDto": {
        "type": "object",
        "properties": {
          "client_id": {
            "type": "string",
            "example": "rms-web-prod"
          },
          "state": {
            "type": "string",
            "example": "b1c9f0d2a7e84f6c",
            "description": "BU-generated CSRF state, echoed back unchanged"
          },
          "origin": {
            "type": "string",
            "example": "https://rms.example.com",
            "description": "Parent origin; must exactly match a registered embed origin"
          },
          "redirect_uri": {
            "type": "string",
            "description": "Selects one of the registered callback URIs"
          },
          "display": {
            "type": "string",
            "enum": [
              "embed",
              "page"
            ],
            "default": "embed"
          }
        },
        "required": [
          "client_id",
          "state"
        ]
      },
      "FederationLogoutDto": {
        "type": "object",
        "properties": {
          "client_id": {
            "type": "string",
            "example": "rms-web-prod",
            "description": "Required for browser-initiated logout from an application"
          },
          "logout_hint": {
            "type": "string",
            "description": "The `sid` from the assertion the application received"
          },
          "post_logout_redirect_uri": {
            "type": "string",
            "description": "Must exactly match a registered post-logout redirect URI"
          },
          "state": {
            "type": "string"
          },
          "its_id": {
            "type": "string",
            "description": "Service-initiated only: revoke every session of this user"
          },
          "sid": {
            "type": "string",
            "description": "Service-initiated only: revoke this session"
          }
        }
      },
      "EmbedLoginDto": {
        "type": "object",
        "properties": {
          "transaction_id": {
            "type": "string",
            "example": "txn-123"
          },
          "client_id": {
            "type": "string",
            "example": "rms-web-prod"
          },
          "identity_type": {
            "type": "string",
            "enum": [
              "ITS",
              "NON_ITS"
            ],
            "default": "ITS"
          },
          "its_id": {
            "type": "string",
            "example": "ITS12345",
            "description": "ITS ID (identity_type ITS)"
          },
          "identifier": {
            "type": "string",
            "example": "member@example.com",
            "description": "Username or email (identity_type NON_ITS)"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "transaction_id",
          "client_id",
          "password"
        ]
      },
      "TransactionRefDto": {
        "type": "object",
        "properties": {
          "transaction_id": {
            "type": "string"
          },
          "client_id": {
            "type": "string"
          }
        },
        "required": [
          "transaction_id",
          "client_id"
        ]
      },
      "EmbedLogoutDto": {
        "type": "object",
        "properties": {
          "transaction_id": {
            "type": "string"
          }
        },
        "required": [
          "transaction_id"
        ]
      },
      "PortalLoginDto": {
        "type": "object",
        "properties": {
          "transaction_id": {
            "type": "string"
          },
          "identity_type": {
            "type": "string",
            "enum": [
              "ITS",
              "NON_ITS"
            ],
            "default": "ITS"
          },
          "its_id": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "transaction_id",
          "password"
        ]
      },
      "SelectScopeDto": {
        "type": "object",
        "properties": {
          "transaction_id": {
            "type": "string",
            "description": "Portal transaction from the login page (CSRF binding)"
          },
          "role_id": {
            "type": "string",
            "example": "6b1f3c2e-8a3d-4a5b-9c1e-2d3f4a5b6c7d"
          },
          "scope_type": {
            "type": "string",
            "enum": [
              "CORE",
              "BUSINESS_UNIT",
              "UTILITY"
            ],
            "example": "UTILITY"
          },
          "scope_id": {
            "type": "object",
            "nullable": true,
            "description": "NULL for CORE, else bu_id or utility_id"
          },
          "audience": {
            "type": "string",
            "enum": [
              "authorization",
              "identity"
            ],
            "default": "authorization",
            "description": "authorization = Core Identity Authorization APIs (e.g. GET /me/permissions); identity = this service (force federation logout)"
          }
        },
        "required": [
          "transaction_id",
          "role_id",
          "scope_type"
        ]
      },
      "PortalLogoutDto": {
        "type": "object",
        "properties": {
          "transaction_id": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "session",
              "federation"
            ],
            "default": "session"
          }
        },
        "required": [
          "transaction_id"
        ]
      }
    }
  }
}