# ---------------------------------------------------------------------------
# Miqaat Identity Federation Service - environment template
# Copy to .env for local development. NEVER commit real values.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Proxy trust for deriving the client IP, which session binding compares against.
#   false            direct exposure (local dev)
#   <n>              trusted proxy hops in front of this service (Render / ALB / nginx: 1)
#   <cidr>[,<cidr>]  trust exactly these proxy addresses
# "true" is refused: it trusts a client-supplied X-Forwarded-For, which would defeat IP binding.
TRUST_PROXY=false
SWAGGER_ENABLED=true

# Public issuer. MUST equal the externally visible origin of this service.
ISSUER=http://localhost:3001

# --- Identity DB: the EXISTING identity database (PostgreSQL) ----------------
# ALL REQUIRED, NO DEFAULTS. Use the exact existing host, port, database, schema and credentials.
# Existing users, passwords and eligibility are READ from users, user_eligible and mumin_master in
# IDENTITY_DB_SCHEMA - never written. The service refuses to start if the schema or any mapped table/column
# is missing (check without starting: npm run db:check). Docker never creates a database, schema or table.
# In Docker, "localhost" is the container itself - use the real database host name.
IDENTITY_DB_HOST=
IDENTITY_DB_PORT=
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_SCHEMA=miqaat_core
IDENTITY_DB_USER=
IDENTITY_DB_PASSWORD=
IDENTITY_DB_SSL=false

# --- Redis (sessions, transactions, rate limits) ----------------------------
# An existing Redis; no Redis container is started by docker-compose.
REDIS_URL=redis://localhost:6391/0

# --- Core Identity Authorization Service (client configuration source) -----
AUTHZ_BASE_URL=http://localhost:3002

# --- Container overrides (optional) ------------------------------------------
# The values above are written for running this service on your machine. Inside a container
# "localhost" is the container itself, so docker-compose substitutes these three instead -
# but ONLY while the database / Redis / authorization service are containers on this machine.
# Pointing at real endpoints (RDS, ElastiCache, a deployed authz)? Leave these unset: compose
# falls back to the values above, which are then correct from anywhere.
DOCKER_IDENTITY_DB_HOST=host.docker.internal
DOCKER_REDIS_URL=redis://host.docker.internal:6391/0
DOCKER_AUTHZ_BASE_URL=http://host.docker.internal:3002

CLIENT_CACHE_TTL_SECONDS=30
# Service-to-service without API keys: this service signs short-lived RS256 service tokens
# (typ client-authentication+jwt, iss = sub = SERVICE_PRINCIPAL_ID) verified by the Authorization service via our JWKS.
AUTHZ_AUDIENCE=miqaat-core-authorization
SERVICE_PRINCIPAL_ID=identity-federation
SERVICE_TOKEN_TTL_SECONDS=120

# --- Signing keys -----------------------------------------------------------
# ssm = SSM Parameter Store (one SecureString per kid, Standard tier) | secretsmanager = AWS
# Secrets Manager | file = local tests only, refused when NODE_ENV=production.
# Development and production both use ssm: keys are generated locally with `npm run keys:generate`
# and written straight to AWS - never kept on disk. Only the path differs between environments.
SIGNING_KEY_PROVIDER=ssm
SSM_SIGNING_KEYS_PATH=/miqaat/identity/dev/signing-keys
AWS_REGION=ap-south-1
# Optional customer-managed KMS key. Empty = the AWS-managed alias/aws/ssm.
SIGNING_KEYS_KMS_KEY_ID=
# Static keys are for local development only. In AWS use an IAM role / IRSA and leave these empty.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# LocalStack only; MUST be empty in production (config validation refuses it there).
AWS_ENDPOINT_URL=
# Used only when SIGNING_KEY_PROVIDER=secretsmanager / file.
SECRETS_MANAGER_SIGNING_KEYS_SECRET_ID=miqaat/identity/dev/signing-keys
SIGNING_KEYS_FILE=./.keys/signing-keys.json
KEY_REFRESH_INTERVAL_SECONDS=300

# --- Lifetimes (seconds) ----------------------------------------------------
ASSERTION_TTL_SECONDS=60
TRANSACTION_TTL_SECONDS=300
# POST /auth/transaction also returns the login page CSRF token (API clients need not parse the HTML).
# Unset: on outside production, off in production. The Origin check applies either way.
# TRANSACTION_API_RETURNS_CSRF=true
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=28800

# --- Federation session cookie ---------------------------------------------
SESSION_COOKIE_NAME=federation_session
COOKIE_SECURE=true
COOKIE_SAMESITE=None
COOKIE_DOMAIN=

# --- Brute force / rate limiting -------------------------------------------
LOGIN_MAX_FAILURES_PER_IDENTIFIER=5
LOGIN_IDENTIFIER_WINDOW_SECONDS=900
LOGIN_ACCOUNT_LOCK_SECONDS=900
LOGIN_MAX_ATTEMPTS_PER_IP=30
LOGIN_IP_WINDOW_SECONDS=300

# --- Core Portal (application launcher) ------------------------------------
PORTAL_ENVIRONMENT=DEV

# --- Access tokens (POST /login, POST /select-scope; carry the active workspace only) ---
ACCESS_TOKEN_TTL_SECONDS=600

# --- Login rules (identity_db) ---------------------------------------------
# Login restriction: the ITS ID must be in user_eligible (legacy MHP_User_Login_Eligible).
# The message is shown only after a correct password.
LOGIN_RESTRICTION_ENABLED=true
LOGIN_RESTRICTION_MESSAGE=You are not eligible to sign in. Please contact your Jamaat office.
# mumin_master.status_id that counts as active (legacy Status_ID = 3)
MHP_ACTIVE_STATUS_ID=3
