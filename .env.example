# ---------------------------------------------------------------------------
# Miqaat Identity Federation Service - environment template
# Copy to .env for local development. NEVER commit real values.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Proxy trust for deriving the client IP, which session binding compares against.
#   false            direct exposure (local dev)
#   <n>              trusted proxy hops in front of this service (Render / ALB / nginx: 1)
#   <cidr>[,<cidr>]  trust exactly these proxy addresses
# "true" is refused: it trusts a client-supplied X-Forwarded-For, which would defeat IP binding.
TRUST_PROXY=false
SWAGGER_ENABLED=true

# Public issuer. MUST equal the externally visible origin of this service.
ISSUER=http://localhost:3001

# --- Authentication DB (PostgreSQL) - passwords live ONLY here ---------------
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5441
AUTH_DB_USER=miqaat_auth
AUTH_DB_PASSWORD=change-me-local
AUTH_DB_NAME=miqaat_auth
AUTH_DB_SSL=false

# --- Redis (sessions, transactions, rate limits) ----------------------------
REDIS_URL=redis://localhost:6391/0

# --- Core Identity Authorization Service (client configuration source) -----
AUTHZ_BASE_URL=http://localhost:3002
CLIENT_CACHE_TTL_SECONDS=30
# Service-to-service without API keys: this service signs short-lived RS256 service tokens
# (typ client-authentication+jwt, iss = sub = SERVICE_PRINCIPAL_ID) verified by the Authorization service via our JWKS.
AUTHZ_AUDIENCE=miqaat-core-authorization
SERVICE_PRINCIPAL_ID=identity-federation
SERVICE_TOKEN_TTL_SECONDS=120

# --- Signing keys -----------------------------------------------------------
# secretsmanager = AWS Secrets Manager (recommended) | ssm = SSM Parameter Store | file = local tests only
SIGNING_KEY_PROVIDER=secretsmanager
SECRETS_MANAGER_SIGNING_KEYS_SECRET_ID=miqaat/identity/dev/signing-keys
# Optional customer-managed KMS key for the secret
SIGNING_KEYS_KMS_KEY_ID=
# LocalStack only (docker compose); leave empty in AWS
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SIGNING_KEYS_FILE=./.keys/signing-keys.json
SSM_SIGNING_KEYS_PATH=/miqaat/identity/dev/signing-keys
AWS_REGION=ap-south-1
KEY_REFRESH_INTERVAL_SECONDS=300

# --- Lifetimes (seconds) ----------------------------------------------------
ASSERTION_TTL_SECONDS=60
TRANSACTION_TTL_SECONDS=300
# POST /auth/transaction also returns the login page CSRF token (API clients need not parse the HTML).
# Unset: on outside production, off in production. The Origin check applies either way.
# TRANSACTION_API_RETURNS_CSRF=true
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=28800

# --- Federation session cookie ---------------------------------------------
SESSION_COOKIE_NAME=federation_session
COOKIE_SECURE=true
COOKIE_SAMESITE=None
COOKIE_DOMAIN=

# --- Brute force / rate limiting -------------------------------------------
LOGIN_MAX_FAILURES_PER_IDENTIFIER=5
LOGIN_IDENTIFIER_WINDOW_SECONDS=900
LOGIN_ACCOUNT_LOCK_SECONDS=900
LOGIN_MAX_ATTEMPTS_PER_IP=30
LOGIN_IP_WINDOW_SECONDS=300

# --- Core Portal (application launcher) ------------------------------------
PORTAL_ENVIRONMENT=DEV

# --- Access tokens (POST /login, POST /select-scope; carry the active workspace only) ---
ACCESS_TOKEN_TTL_SECONDS=600

# --- Legacy MMS (SQL Server) - ONLY used by `npm run migrate:legacy` --------
# Use a READ-ONLY account. Values belong in .env / secret manager, never git.
LEGACY_DB_HOST=
LEGACY_DB_PORT=1433
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
LEGACY_DB_NAME=MMS
LEGACY_DB_ENCRYPT=false
LEGACY_MIGRATION_LIMIT=50
LEGACY_INCLUDE_USER_IDS=

# --- Dev-only seed for a NON-ITS demo member -------------------------------
DEV_NON_ITS_USERNAME=guest.member@example.com
DEV_NON_ITS_PASSWORD=

# --- Dev-only: password for the Role & Permission Module demo ITS IDs not present in MMS ---
DEV_DEMO_PASSWORD=

# --- Embedded Login: legacy MHP gate -------------------------------------------------
# Eligibility gate (MHP_User_Login_Eligible -> synced -> Status_ID -> Allow_Login), read from
# the users.mhp_* columns that migrate:legacy mirrors. Portal login is never gated.
MHP_ELIGIBILITY_REQUIRED=true
MHP_ACTIVE_STATUS_ID=3
# Which credential Embedded Login checks once the gate passes:
#   legacy-decrypt  decrypt MHP_User_Login.Password in MMS and compare - and nothing else.
#                   Needs LEGACY_LOGIN_ENABLED=true and a reachable MMS. Any account without a
#                   legacy row (every LOCAL-only account) can no longer sign in.
#   scrypt          verify users.password_hash, as portal login does. Use this where MMS is
#                   unreachable (e.g. a cloud deployment) - otherwise the service refuses to boot.
EMBEDDED_LOGIN_PASSWORD_SOURCE=legacy-decrypt
